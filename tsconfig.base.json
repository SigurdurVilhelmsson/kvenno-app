{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* The global type packages, named. TypeScript 6 no longer loads every installed @types
       package by itself (its default is now none), and the tests use Node's (node:fs,
       __dirname). vite/client declares import.meta.env and the *.css and asset modules, which
       the games that include only their own src had no route to. server/ and e2e/ set their
       own. */
    "types": ["node", "vite/client"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases. No baseUrl: TypeScript 6 deprecates it, and since 4.1 each path resolves
       from the tsconfig that declares it, which is what every entry below already assumes. */
    "paths": {
      "@kvenno/shared": ["./packages/shared/index.ts"],
      "@kvenno/shared/*": ["./packages/shared/*"],
      "@shared/*": ["./packages/shared/*"]
    }
  },
  "include": ["packages/shared/**/*"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
