{
  "name": "kvenno-server",
  "version": "1.0.0",
  "description": "Express.js backend server for kvenno.app",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
