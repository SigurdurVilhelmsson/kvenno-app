# ====================================================================
# BACKEND SERVER ENVIRONMENT VARIABLES (server/.env)
# ====================================================================
# These variables are NEVER exposed to the client
# Keep this file secure and NEVER commit to git
# ====================================================================

# Claude API Key (REQUIRED)
# Get your API key from: https://console.anthropic.com/
# This is a SECRET - keep it secure!
CLAUDE_API_KEY=sk-ant-your-api-key-here

# Server Port
# IMPORTANT: Use port 8000 as specified in KVENNO-STRUCTURE.md Section 3
# nginx will proxy requests from /api/ to this port
PORT=8000

# Node Environment
NODE_ENV=production

# Frontend URL (for CORS)
# Allow requests from these domains
FRONTEND_URL=https://kvenno.app

# Microsoft sign-in (REQUIRED for the lab-report endpoints)
# /api/analyze, /api/analyze-2ar and /api/process-document accept only a request carrying the
# signed-in user's Microsoft ID token, checked against this tenant and app. Use the same values as
# VITE_AZURE_TENANT_ID and VITE_AZURE_CLIENT_ID in apps/lab-reports/.env. With either unset those
# endpoints answer 503: the server fails closed rather than open.
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id

# Local development only: skip the sign-in check, to pair with VITE_BYPASS_AUTH=true in the
# front end. Ignored when NODE_ENV=production.
# AUTH_DISABLED=true
