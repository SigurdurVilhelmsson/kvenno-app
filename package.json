{
  "name": "@kvenno/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kvennaskólinn Education Platform - Unified Monorepo",
  "author": "Kvennaskólinn",
  "license": "MIT",
  "scripts": {
    "dev:landing": "pnpm --filter @kvenno/landing dev",
    "dev:lab-reports": "pnpm --filter @kvenno/lab-reports dev",
    "dev:islenskubraut": "pnpm --filter @kvenno/islenskubraut dev",
    "dev:games": "pnpm --filter './apps/games/**' dev",
    "build": "node scripts/build-all.mjs",
    "build:landing": "pnpm --filter @kvenno/landing build",
    "build:lab-reports": "pnpm --filter @kvenno/lab-reports build",
    "build:islenskubraut": "pnpm --filter @kvenno/islenskubraut build",
    "build:games": "node scripts/build-games.mjs",
    "build:game": "node scripts/build-games.mjs --game",
    "build:year": "node scripts/build-games.mjs --year",
    "islenskubraut:build": "node scripts/islenskubraut/build.mjs",
    "islenskubraut:export": "node scripts/islenskubraut/export-xlsx.mjs",
    "islenskubraut:import": "node scripts/islenskubraut/import-xlsx.mjs",
    "type-check": "pnpm --recursive run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json}\"",
    "test": "vitest run && pnpm --filter kvenno-server test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check-all": "pnpm type-check && pnpm lint && pnpm format:check",
    "analyze": "node scripts/analyze-bundles.mjs",
    "clean": "pnpm --recursive run clean && rm -rf node_modules dist",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {}
}
